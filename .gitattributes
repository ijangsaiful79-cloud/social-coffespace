# Force LF line endings on Linux server (prevent CRLF from Windows Git Bash)
* text=auto eol=lf

# Shell scripts must always be LF
*.sh text eol=lf

# Config files
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.env text eol=lf
*.md text eol=lf

# Binary files — no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
